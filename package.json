{
  "name": "easyjam",
  "version": "1.0.0",
  "private": true,
  "description": "Collaborative YouTube music streaming for LAN parties",
  "license": "MIT",
  "author": "Louis Besle",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/louis-besle/EasyJam.git"
  },
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "test": "node --test test/*.test.js",
    "test:e2e": "node --test test/e2e/*.test.js",
    "test:visual": "node --test test/e2e/visual.test.js",
    "snapshots": "node scripts/update-snapshots.js",
    "test:load": "node --test test/load/*.test.js",
    "test:all": "npm test && npm run test:e2e && npm run test:load",
    "check": "npm test && node --check public/app.js && node --check public/ui.js && node --check public/player.js"
  },
  "dependencies": {
    "express": "^4.21.0",
    "uuid": "^10.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "pixelmatch": "^5.3.0",
    "pngjs": "^7.0.0",
    "puppeteer-core": "^25.1.0"
  }
}
